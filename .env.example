# Copy to `.env` and fill in values (or sync from Railway).
# Do not commit `.env` to a public repository.

WP_URL=https://www.culturaldaily.com
WP_USER=
WP_PASS=

WP_URL_DCR=
WP_USER_DCR=
WP_PASS_DCR=
# Backward-compatible aliases also supported:
# DCR_WP_URL=
# DCR_WP_USER=
# DCR_WP_PASS=

PEXELS_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

SECRET_KEY=
DASHBOARD_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Outbound SMS (E.164). If unset, pipeline uses first number from Twilio IncomingPhoneNumbers API.
TWILIO_SMS_FROM=
# Recipient E.164 for draft alerts (default +5215549571586 in code if unset).
SMS_TO=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

OUR_FRIENDS_AUTHOR_ID=19
